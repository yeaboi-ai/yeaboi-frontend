{
  "name": "yeaboi-web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Front-end bundles for yeaboi's boards, share gate, slide deck and exported pages. Published to PyPI as the data-only wheel yeaboi-web-assets.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node build-all.mjs",
    "dev": "vite",
    "gen-enums": "node scripts/gen-enums.mjs",
    "gen-enums:check": "node scripts/gen-enums.mjs --check",
    "typecheck": "npm run gen-enums:check && tsc --noEmit",
    "lint": "npm run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "preact": "^10.29.1"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/preact": "^3.2.4",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^26.1.2",
    "axe-core": "^4.12.1",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^4.1.10",
    "vitest-axe": "^0.1.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yeaboi-ai/yeaboi-frontend.git"
  }
}
